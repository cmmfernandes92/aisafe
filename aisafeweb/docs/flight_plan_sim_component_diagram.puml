@startuml FlightPlanSimulator_Components

title Flight Plan Simulator · Component Architecture
skinparam componentStyle rectangle
skinparam shadowing false
skinparam roundCorner 6
skinparam defaultFontName "Helvetica"
skinparam ArrowColor #5A6B7B
skinparam ArrowFontColor #5A6B7B
skinparam noteBackgroundColor #FFFDF0
skinparam noteBorderColor #D8C97A
skinparam actorStyle awesome

skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #B0BAC4
  FontColor #2A3B4C
  FontStyle bold
}
skinparam component {
  BackgroundColor #EEF3F8
  BorderColor #3B6EA5
  FontColor #1A2B3C
}
skinparam artifact {
  BackgroundColor #FFF6E6
  BorderColor #C49A4A
  FontColor #2A3B4C
}

actor "Pilot / Power User" as user

package "aisafeweb (Spring Boot server)" as server {
  component "AisafeWebModule\n<size:10>nav entry + route constant</size>" as module
  component "SimulatorController\n<size:10>HTTP route + access guard</size>" as controller
  component "pilot-simulate-flight.html\n<size:10>page template</size>" as template
  component "Shared chrome\n<size:10>layout.html · app.css · sidebar.js</size>" as chrome
}

package "Browser (client runtime)" as browser {
  component "simulator-flight.js\n<size:10>engine: flight model + render loop + cameras</size>" as engine
  package "Vendor libs" as vendor #F9F9F9 {
    component "MapLibre GL" as maplibre #FFFFFF
    component "Three.js" as three #FFFFFF
  }
}

package "Flight plan providers (planned, server-side)" as source #F4F4F4 {
  component "Flight DSL\n<size:10>LPROG · ANTLR: .flight → AST</size>" as dsl #FAFAFA
  component "aisafe domain\n<size:10>persisted flight plan (repository)</size>" as domain #FAFAFA
}

artifact "Flight plan (JSON)\n<size:10>waypoints · levels · times</size>" as plan #F4F4F4

user       --> controller : HTTP GET
module     ..> controller : registers nav entry
controller --> template   : renders\n(post auth/access guard)
template   ..> chrome      : includes fragments
controller --> browser    : delivers HTML + JS
template   --> engine     : bootstraps\n(import map)
engine     --> maplibre   : uses
engine     --> three      : uses
controller ..> dsl    : parse .flight
controller ..> domain : load persisted
controller ..> plan   : build + serialize
plan       ..> engine : consume\n(replaces hardcoded route)

note bottom of browser
  Fully client-side rendering: the server delivers HTML
  and static JS only. All motion, geometry and rendering
  run in the browser.
end note

note right of source
  Today the engine uses a hardcoded LPPR→LPPT route with a
  scripted altitude profile. The planned hook loads a real
  flight plan server-side (DSL parse or persisted domain),
  serializes it to JSON, and feeds it to the engine in place
  of the straight-line lerp and altProfile.
end note
@enduml