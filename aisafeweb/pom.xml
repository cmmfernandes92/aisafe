<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.3</version>
        <relativePath/>
    </parent>

    <groupId>eapli</groupId>
    <artifactId>aisafeweb</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>AISafe Web</name>
    <description>Separate HTMX/Tailwind web adapter for AISafe.</description>

    <properties>
        <java.version>21</java.version>
        <aisafe.version>1.0.0-SNAPSHOT</aisafe.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <dependency>
            <groupId>eapli</groupId>
            <artifactId>aisafe.core</artifactId>
            <version>${aisafe.version}</version>
        </dependency>
        <dependency>
            <groupId>eapli</groupId>
            <artifactId>aisafe.persistence.impl</artifactId>
            <version>${aisafe.version}</version>
        </dependency>
        <dependency>
            <groupId>eapli</groupId>
            <artifactId>aisafe.bootstrappers</artifactId>
            <version>${aisafe.version}</version>
        </dependency>
        <!-- US120 compiler: the web adapter validates the DSL file before calling
             the core ImportFlightPlanController, mirroring the pilot console. -->
        <dependency>
            <groupId>eapli</groupId>
            <artifactId>aisafe.flightplandsl</artifactId>
            <version>${aisafe.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
