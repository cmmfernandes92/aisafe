@startuml us071_class_diagram

skinparam classAttributeIconSize 0
skinparam classBackgroundColor #D6EAF8
skinparam classBorderColor #5B9BD5
skinparam classFontColor #1A1A1A
skinparam packageStyle rectangle
skinparam packageBackgroundColor transparent
skinparam packageBorderColor #888888
skinparam defaultFontSize 11
hide empty members

skinparam class {
    BackgroundColor<<external>> #EAEDED
    BorderColor<<external>> #95A5A6
    FontColor<<external>> #1A1A1A
}

' ============================================
' PRESENTATION (aisafe.app.atcc.console)
' ============================================
package "Presentation" {
    class MainMenu <<external>> {
        + buildMainMenu()
    }
    class DecommissionAircraftAction {
        + execute() : boolean
    }
    class DecommissionAircraftUI {
        + doShow() : boolean
    }
}

' ============================================
' APPLICATION (aisafe.core)
' ============================================
package "Application" {
    class DecommissionAircraftController <<UseCaseController>> {
        + listActiveAircraftForAuthenticatedCollaborator() : Iterable<Aircraft>
        + decommission(registration : Registration) : Aircraft
    }
}

' ============================================
' DOMAIN (aisafe.core)
' ============================================
package "Domain" {
    class Aircraft <<aggregate root>> {
        + identity() : Registration
        + status() : OperationalStatus
        + decommission() : void
    }
    class Registration <<value object>>
    enum OperationalStatus <<enum>> {
        ACTIVE
        RETIRED
    }
    interface AircraftRepository {
        + findByRegistration(Registration) : Optional<Aircraft>
        + findAllActiveByCompany(companyId) : Iterable<Aircraft>
        + save(Aircraft) : Aircraft
    }

    ' External — resolved from authenticated user
    class CompanyCollaborator <<external>>
    interface CompanyCollaboratorRepository <<external>> {
        + findByUser(username) : Optional<CompanyCollaborator>
    }

    ' External — pending flights guard
    class Flight <<external>>
    interface FlightRepository <<external>> {
        + hasPendingFlightsForAircraft(Registration) : boolean
    }
}

' ============================================
' INFRASTRUCTURE (eapli.framework)
' ============================================
package "Infrastructure" {
    class AuthorizationService <<external>> {
        + session() : UserSession
        + loggedinUserWithPermission(role) : SystemUser
    }
}

' ============================================
' PERSISTENCE (aisafe.persistence.impl)
' ============================================
package "Persistence" {
    class InMemoryAircraftRepository
    class JpaAircraftRepository
}

' ============================================
' Relationships
' ============================================
MainMenu --> DecommissionAircraftAction : registers
DecommissionAircraftAction ..> DecommissionAircraftUI : invokes
DecommissionAircraftUI ..> DecommissionAircraftController : uses

DecommissionAircraftController ..> AuthorizationService : gets logged-in user
DecommissionAircraftController ..> CompanyCollaboratorRepository : resolves company
DecommissionAircraftController ..> AircraftRepository : uses
DecommissionAircraftController ..> FlightRepository : checks pending flights
DecommissionAircraftController ..> Aircraft : decommissions

Aircraft *-- Registration
Aircraft *-- OperationalStatus

Flight --> Aircraft : references <<external>>

InMemoryAircraftRepository ..|> AircraftRepository
JpaAircraftRepository ..|> AircraftRepository

@enduml
