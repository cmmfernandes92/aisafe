@startuml us070_domain_model_excerpt

skinparam classAttributeIconSize 0
skinparam classBackgroundColor #D6EAF8
skinparam classBorderColor #5B9BD5
skinparam classFontColor #1A1A1A
skinparam packageStyle rectangle
skinparam packageBackgroundColor transparent
skinparam packageBorderColor #888888
skinparam defaultFontSize 11
hide empty members
left to right direction

skinparam class {
    BackgroundColor<<external>> #EAEDED
    BorderColor<<external>> #95A5A6
    FontColor<<external>> #1A1A1A
}

' ============================================
' AGGREGATE: Aircraft (this US)
' ============================================
package "Aircraft Aggregate" {
    class Aircraft <<aggregate root>> {
        + crewCount
    }
    class Registration <<value object>>
    class CabinConfiguration <<value object>>
    class EconomySeats <<value object>>
    class BusinessSeats <<value object>>
    class FirstClassSeats <<value object>>
    class Country <<value object>>
    enum SeatClass <<enum>> {
        ECONOMY
        BUSINESS
        FIRST
    }
    enum OperationalStatus <<enum>> {
        ACTIVE
        RETIRED
    }

    Aircraft *-- Registration
    Aircraft *-- CabinConfiguration
    Aircraft *-- Country
    Aircraft *-- OperationalStatus
    CabinConfiguration *-- "1" EconomySeats
    CabinConfiguration *-- "0..1" BusinessSeats
    CabinConfiguration *-- "0..1" FirstClassSeats
    CabinConfiguration ..> SeatClass : uses
}

' ============================================
' EXTERNAL AGGREGATES (reference only, grey)
' ============================================
package "AircraftModel Aggregate" #EEEEEE {
    class AircraftModel <<aggregate root>> <<external>>
}
package "AirTransportCompany Aggregate" #EEEEEE {
    class AirTransportCompany <<aggregate root>> <<external>>
}
package "CompanyCollaborator Aggregate" #EEEEEE {
    class CompanyCollaborator <<aggregate root>> <<external>>
}

' ============================================
' CROSS-AGGREGATE RELATIONSHIPS
' ============================================
Aircraft --> AircraftModel : is of model
Aircraft --> AirTransportCompany : belongs to

CompanyCollaborator --> AirTransportCompany : belongs to
note on link
  Resolved from authenticated
  session to determine which
  company the actor represents
end note

@enduml
