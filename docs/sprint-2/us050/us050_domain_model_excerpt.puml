@startuml
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #D6EAF8
skinparam classBorderColor #5B9BD5
skinparam classFontColor #1A1A1A
skinparam packageStyle rectangle
skinparam packageBackgroundColor transparent
skinparam packageBorderColor #888888
skinparam defaultFontSize 11

skinparam class {
    BackgroundColor<<external>> #EAEDED
    BorderColor<<external>> #95A5A6
    FontColor<<external>> #1A1A1A
}

hide empty members

package "AirControlArea Aggregate" {
    class AirControlArea <<aggregate root>>
    class AreaCode <<value object>>
    class AreaName <<value object>>
    class GeographicBoundary <<value object>>
    class Coordinates <<value object>> {
        latitude
        longitude
    }

    AirControlArea *-- AreaCode
    AirControlArea *-- AreaName
    AirControlArea *-- GeographicBoundary

    GeographicBoundary *-- "2" Coordinates : SW, NE
}

' External aggregates that reference AirControlArea
class Airport <<aggregate root>> <<external>>

class WeatherData <<aggregate root>> <<external>>


Airport --> AirControlArea : located in
WeatherData --> AirControlArea : for area

note right of AirControlArea
  Invariants:
  - AreaCode unique system-wide
  - AreaName unique system-wide
  - Non-zero rectangle (SW < NE on both axes)
  - No overlap with existing areas
end note

note bottom of Coordinates
  Range enforced at construction:
  latitude in [-90, 90]
  longitude in [-180, 180]
end note

@enduml