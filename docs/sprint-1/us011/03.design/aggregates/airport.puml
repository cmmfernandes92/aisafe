@startuml

skinparam classAttributeIconSize 0
skinparam classBackgroundColor #D6EAF8
skinparam classBorderColor #5B9BD5
skinparam classFontColor #1A1A1A
skinparam packageStyle rectangle
skinparam packageBackgroundColor transparent
skinparam packageBorderColor #888888
skinparam defaultFontSize 11
hide empty members
left to right direction


' ============================================
' AGGREGATE: Airport
' ============================================
package "Airport Aggregate" {
    class Airport <<aggregate root>> {
        airportName
        town
        country
        elevation
    }
    class AirportIATACode <<value object>>
    class AirportICAOCode <<value object>>
    class AirportCoordinates <<value object>>

    Airport *-- AirportIATACode
    Airport *-- AirportICAOCode
    Airport *-- AirportCoordinates
}


@enduml