@startuml

skinparam classAttributeIconSize 0
skinparam classBackgroundColor #D6EAF8
skinparam classBorderColor #5B9BD5
skinparam classFontColor #1A1A1A
skinparam packageStyle rectangle
skinparam packageBackgroundColor transparent
skinparam packageBorderColor #888888
skinparam defaultFontSize 11
hide empty members
left to right direction

package "CompanyCollaborator Aggregate" {
    class CompanyCollaborator <<aggregate root>> {
        position
    }

    enum CollaboratorStatus <<enum>> {
        ACTIVE
        DISABLED
    }

    CompanyCollaborator *-- CollaboratorStatus
}

' Cross-aggregate references
class AirTransportCompany <<aggregate root>> #White
class User <<aggregate root>> #White

CompanyCollaborator --> AirTransportCompany : belongs to
CompanyCollaborator --> User : identity

@enduml