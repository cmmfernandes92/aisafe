@startuml

skinparam classAttributeIconSize 0
skinparam classBackgroundColor #D6EAF8
skinparam classBorderColor #5B9BD5
skinparam classFontColor #1A1A1A
skinparam packageStyle rectangle
skinparam packageBackgroundColor transparent
skinparam packageBorderColor #888888
skinparam defaultFontSize 11
hide empty members

package "AircraftModel Aggregate" {
    class AircraftModel <<aggregate root>> {
        modelID
        modelName
        emptyWeight
        mtow
        mzfw
        maxFuelCapacity
        serviceCeiling
        cruiseSpeed
        wingArea
        dragCoefficient
        liftCoefficient
        maximumRange
    }
    enum Type <<enum>> {
        PASSENGER
        CARGO
        MIXED
    }
    enum MotorizationType <<enum>> {
        TURBOPROP
        TURBOFAN
        TURBOJET
        RAMJET
        ELECTRIC_PROPELLER
    }

    AircraftModel *-- Type
    AircraftModel *-- MotorizationType
}

@enduml