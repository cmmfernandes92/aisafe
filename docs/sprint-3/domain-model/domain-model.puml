@startuml

skinparam classAttributeIconSize 0
skinparam classBackgroundColor #D6EAF8
skinparam classBorderColor #5B9BD5
skinparam classFontColor #1A1A1A
skinparam packageStyle rectangle
skinparam defaultFontSize 11
hide empty members
skinparam nodesep 30
skinparam ranksep 55
top to bottom direction
skinparam packageBackgroundColor transparent
skinparam packageBorderColor #888888

' Group containers below force layout only and are made invisible inline
' (#line:transparent;back:transparent;text:transparent on each package).

' ############################################
' GROUP: Fleet & Engineering
' ############################################
package "Fleet & Engineering" <<group>> #line:transparent;back:transparent;text:transparent {

' ============================================
' AGGREGATE: Maker
' ============================================
package "Maker Aggregate" {
    class Maker <<aggregate root>> {
        name
    }
}

' ============================================
' AGGREGATE: AircraftModel
' ============================================
package "AircraftModel Aggregate" {
    class AircraftModel <<aggregate root>> {
        modelID
        modelName
        emptyWeight
        mtow
        mzfw
        maxFuelCapacity
        serviceCeiling
        cruiseSpeed
        wingArea
        dragCoefficient
        liftCoefficient
        maximumRange
    }
    enum Type <<enum>> {
        PASSENGER
        CARGO
        MIXED
    }
    enum MotorizationType <<enum>> {
        TURBOPROP
        TURBOFAN
        TURBOJET
        RAMJET
        ELECTRIC_PROPELLER
    }

    AircraftModel *-- Type
    AircraftModel *-- MotorizationType
}

' ============================================
' AGGREGATE: EngineModel
' ============================================
package "EngineModel Aggregate" {
    class EngineModel <<aggregate root>> {
        engineModelName
        power
        efficiency
    }
    enum MotorizationType <<enum>> {
        TURBOPROP
        TURBOFAN
        TURBOJET
        RAMJET
        ELECTRIC_PROPELLER
    }
    enum FuelType <<enum>> {
        JET_A
        JET_A1
        AVGAS
        HYDROGEN
        ELECTRIC
        SUSTAINABLE_AVIATION_FUEL
    }

    EngineModel *-- MotorizationType
    EngineModel *-- "1..*" FuelType
}

' ============================================
' AGGREGATE: Aircraft
' ============================================
package "Aircraft Aggregate" {
    class Aircraft <<aggregate root>> {
        crewCount
    }
    class Registration <<value object>>
    class CabinConfiguration <<value object>>

    class EconomySeats <<value object>>
    class BusinessSeats <<value object>>
    class FirstClassSeats <<value object>>
    enum SeatClass <<enum>> {
        ECONOMY
        BUSINESS
        FIRST
    }
    enum OperationalStatus <<enum>> {
        ACTIVE
        RETIRED
    }

    Aircraft *-- Registration
    Aircraft *-- CabinConfiguration
    Aircraft *-- OperationalStatus


    CabinConfiguration *-- "1" EconomySeats
    CabinConfiguration *-- "0..1" BusinessSeats
    CabinConfiguration *-- "0..1" FirstClassSeats
    CabinConfiguration *-- SeatClass
}

' ============================================
' AGGREGATE: Country
' ============================================
package "Country Aggregate" {
    class Country <<aggregate root>> {
        name
    }
    class CountryCode <<value object>>

    Country *-- CountryCode
}

}

' ############################################
' GROUP: People & Org
' ############################################
package "People & Org" <<group>> #line:transparent;back:transparent;text:transparent {

' ============================================
' AGGREGATE: User
' ============================================
package "User Aggregate" {
    class User <<aggregate root>> {
        fullName
    }
    class Email <<value object>>
    class PhoneNumber <<value object>>
    class Credential <<value object>>
    class SecurityClearance <<value object>> {
        expirationDate
    }
    class SkillsAssessment <<value object>> {
        lastAssessmentDate
    }
    enum AisafeRoles <<enum>> {
        ADMIN
        BACKOFFICE_OPERATOR
        AIR_TRANSPORT_COMPANY_COLLABORATOR
        PILOT
        FLIGHT_CONTROL_OPERATOR
        WEATHER_PERSON
    }
    enum UserStatus <<enum>> {
        ACTIVE
        DISABLED
    }

    User *-- Email
    User *-- PhoneNumber
    User *-- Credential
    User *-- AisafeRoles
    User *-- UserStatus
    User *-- "0..1" SecurityClearance : holds
    User *-- "0..1" SkillsAssessment
}

' ============================================
' AGGREGATE: Collaborator
' ============================================
package "Collaborator Aggregate" {
    abstract class Collaborator <<aggregate root>>
    class CompanyCollaborator <<entity>>
    class AreaCollaborator <<entity>>
    class Position <<value object>>
    enum CollaboratorStatus <<enum>> {
        ACTIVE
        DISABLED
    }

    CompanyCollaborator --|> Collaborator
    AreaCollaborator --|> Collaborator

    Collaborator *-- Position
    Collaborator *-- CollaboratorStatus
}

' ============================================
' AGGREGATE: Pilot
' ============================================
package "Pilot Aggregate" {
    class Pilot <<aggregate root>>
    class PilotCertification <<entity>>
    enum PilotStatus <<enum>> {
        ACTIVE
        INACTIVE
    }

    Pilot *-- PilotStatus
    Pilot *-- "1..*" PilotCertification
}

' ============================================
' AGGREGATE: AirTransportCompany
' ============================================
package "AirTransportCompany Aggregate" {
    class AirTransportCompany <<aggregate root>> {
        companyName
    }
    class CompanyIATACode <<value object>>
    class CompanyICAOCode <<value object>>

    AirTransportCompany *-- CompanyIATACode
    AirTransportCompany *-- CompanyICAOCode
}

}

' ############################################
' GROUP: Flight Operations
' ############################################
package "Flight Operations" <<group>> #line:transparent;back:transparent;text:transparent {

' ============================================
' AGGREGATE: FlightRoute
' ============================================
package "FlightRoute Aggregate" {
    class FlightRoute <<aggregate root>> {
        active : boolean
    }
    class RouteName <<value object>>

    FlightRoute *-- RouteName
}

' ============================================
' AGGREGATE: Flight
' ============================================
package "Flight Aggregate" {
    class Flight <<aggregate root>>
    class FlightDesignator <<value object>>
    abstract class Departure <<value object>>
    class CharterDeparture <<value object>> {
        departureDate
        departureTime
    }
    class RegularDeparture <<value object>>
    class WeekdaySchedule <<value object>> {
        weekday
    }
    class DepartureTime <<value object>>
    class FlightPlan <<entity>> {
        flightPlanID
    }
    class FlightLeg <<entity>>
    class DepartureInfo <<value object>>
    class ArrivalInfo <<value object>>
    class FuelLoad <<value object>>
    class FlightSegment <<entity>>
    class Waypoint <<value object>>
    class Coordinates <<value object>>
    class AltitudeSlot <<value object>>
    class WindDirection <<value object>>
    class WindSpeed <<value object>>
    enum FlightPlanStatus <<enum>> {
        DRAFT
        VALIDATED
        TESTED
    }

    CharterDeparture --|> Departure
    RegularDeparture --|> Departure
    Flight *-- FlightDesignator
    Flight *-- Departure
    RegularDeparture *-- "1..*" WeekdaySchedule
    WeekdaySchedule *-- "1..*" DepartureTime

    Flight *-- "1..*" FlightPlan
    FlightPlan *-- FlightPlanStatus
    FlightPlan *-- "1..*" FlightLeg

    FlightLeg *-- DepartureInfo
    FlightLeg *-- ArrivalInfo
    FlightLeg *-- FuelLoad
    FlightLeg *-- "1..*" FlightSegment

    FlightSegment *-- "2" Waypoint : start, end
    FlightSegment *-- "1..*" AltitudeSlot
    FlightSegment *-- WindDirection
    FlightSegment *-- WindSpeed

    Waypoint *-- Coordinates
}

' ============================================
' AGGREGATE: SimulationRun
' ============================================
package "SimulationRun Aggregate" {
    class SimulationRun <<aggregate root>> {
        simulationID
        safetyThreshold
    }
    class TimeRange <<value object>>
    class PerformanceSettings <<value object>>
    class SimulationResult <<entity>>
    class SafetyViolation <<entity>> {
        violationTimestamp
        horizontalDistance
        verticalDistance
    }
    enum ViolationKind <<enum>> {
        SEPARATION
        ALTITUDE_CEILING
        ALTITUDE_FLOOR
        UNKNOWN
    }
    class InvolvedFlight <<value object>> {
        flightDesignator
        position
        velocity
    }
    class FlightExecutionStatus <<entity>> {
        flightDesignator
        exitCode
    }
    enum FlightOutcome <<enum>> {
        COMPLETED
        ABORTED
        TERMINATED_BY_VIOLATION
        CRASHED
    }
    enum SimulationStatus <<enum>> {
        CREATED
        RUNNING
        COMPLETED
        FAILED
    }
    enum ValidationOutcome <<enum>> {
        PASS
        FAIL
    }

    SimulationRun *-- TimeRange
    SimulationRun *-- SimulationStatus
    SimulationRun *-- PerformanceSettings
    SimulationRun *-- "0..1" SimulationResult

    SimulationResult *-- ValidationOutcome
    SimulationResult *-- "0..*" FlightExecutionStatus
    SimulationResult *-- "0..*" SafetyViolation

    FlightExecutionStatus *-- FlightOutcome
    SafetyViolation *-- ViolationKind
    SafetyViolation *-- "1..2" InvolvedFlight : one per involved flight\n(1 = altitude bust · 2 = loss of separation)
}

}

' ############################################
' GROUP: Airspace & Weather
' ############################################
package "Airspace & Weather" <<group>> #line:transparent;back:transparent;text:transparent {

' ============================================
' AGGREGATE: AirControlArea
' ============================================
package "AirControlArea Aggregate" {
    class AirControlArea <<aggregate root>>
    class AreaCode <<value object>>
    class AreaName <<value object>>
    class GeographicBoundary <<value object>>
    class Coordinates <<value object>> {
        latitude
        longitude
    }

    AirControlArea *-- AreaCode
    AirControlArea *-- AreaName
    AirControlArea *-- GeographicBoundary

    GeographicBoundary *-- "2" Coordinates : SW, NE
}

' ============================================
' AGGREGATE: Airport
' ============================================
package "Airport Aggregate" {
    class Airport <<aggregate root>>
    class AirportIATACode <<value object>>
    class AirportICAOCode <<value object>>
    class AirportName <<value object>>
    class Town <<value object>>
    class Elevation <<value object>>
    class AirportCoordinates <<value object>>

    Airport *-- AirportIATACode
    Airport *-- AirportICAOCode
    Airport *-- AirportName
    Airport *-- Town
    Airport *-- Elevation
    Airport *-- AirportCoordinates
}

' ============================================
' AGGREGATE: WeatherData
' ============================================
package "WeatherData Aggregate" {
    class WeatherData <<aggregate root>> {
        temperature
        atmosphericPressure
        visibility
    }
    class WeatherDataId <<value object>>
    class TimePeriod <<value object>> {
        startTime
        endTime
    }
    class WeatherZone <<value object>>
    class AltitudeBand <<value object>> {
        lowerFeet
        upperFeet
    }
    class WeatherWindSpeed <<value object>>
    class WeatherWindDirection <<value object>>
    class DataSource <<value object>>

    WeatherData *-- WeatherDataId
    WeatherData *-- TimePeriod
    WeatherData *-- WeatherZone
    WeatherData *-- WeatherWindSpeed
    WeatherData *-- WeatherWindDirection
    WeatherData *-- DataSource

    WeatherZone *-- AltitudeBand
    WeatherZone *-- "2" Coordinates : SW, NE
}

}

' ============================================
' CROSS-AGGREGATE RELATIONSHIPS
' ============================================

' Maker connections
AircraftModel --> Maker : manufactured by
EngineModel --> Maker : manufactured by
Maker --> Country : based in

' AircraftModel <-> EngineModel
AircraftModel --> "1..*" EngineModel : certified engines

' Collaborator connections
Collaborator --> User : identity
Collaborator --> AirTransportCompany : belongs to
Collaborator --> AirControlArea : belongs to

' Pilot connections
Pilot --> AirTransportCompany : belongs to
Pilot --> User : identity
Pilot --> AircraftModel : certified for

' Aircraft connections
Aircraft --> AircraftModel : is of model
Aircraft --> EngineModel : uses
Aircraft --> AirTransportCompany : belongs to
Aircraft --> Country : registered in

' Airport connections
Airport --> AirControlArea : located in
Airport --> Country : located in country


' Flight connections
Flight --> FlightRoute : for route
Flight --> Aircraft : uses
Flight --> Pilot : assigned to
Flight --> AirTransportCompany : belongs to
Flight --> Airport : leg departure
Flight --> Airport : leg arrival

' FlightRoute connections
FlightRoute --> "2" Airport : origin, destination
FlightRoute --> AirTransportCompany : belongs to

' WeatherData connections
WeatherData --> AirControlArea : for area

' SimulationRun connections
SimulationRun --> WeatherData : uses weather
SimulationRun --> "1..*" Flight : includes flights

' ============================================
' LAYOUT: force group order
' ============================================
Aircraft -[hidden]right- Flight
Flight -[hidden]right- WeatherData
User -[hidden]down- WeatherData



' ============================================
' INVARIANTS
' ============================================
' Maker Aggregate:
'   - name must be unique (case-insensitive)
'   - Must reference exactly one Country (country of origin)
'   - Predefined set may be bootstrapped; new makers can be added
'   - A single Maker may produce both aircraft and engine models
'
' AircraftModel Aggregate:
'   - modelID must not be null
'   - modelName + Maker (manufacturer) must be unique
'   - At least one certified engine model
'   - Engine motorization type must be compatible with aircraft motorization type
'   - An EngineModel must exist before being added to the certified engines list
'   - The same engine model cannot be added twice to the same AircraftModel
'   - An EngineModel cannot be removed if any Aircraft uses that aircraft-model/engine combination
'   - Removing an EngineModel cannot leave the AircraftModel with zero certified engines
'
' EngineModel Aggregate:
'   - engineModelName + Maker (manufacturer) must be unique
'   - FuelType set is bootstrapped; new fuel types may be added in future iterations
'   - An EngineModel works with a limited set of compatible FuelTypes
'   - power is engine-rated; thrust is a product of engine + propeller combination
'
' User Aggregate:
'   - Email must be unique
'   - Internal-role emails must use one of the approved domains; external-role
'     collaborators (ATCC, FCO, Pilot) are not subject to domain verification
'   - User must have exactly one AisafeRoles
'   - UserStatus transitions: ACTIVE <-> DISABLED (by Administrator only)
'   - Disabling a user is strictly a status change; it does not cascade to
'     remove collaborator/pilot associations
'   - Credential is stored hashed; plain-text passwords are never persisted
'   - SecurityClearance.expirationDate gates login: an expired clearance prevents
'     authentication but does not change UserStatus
'   - SkillsAssessment.lastAssessmentDate becomes "outdated" after 5 years;
'     an outdated assessment has no effect on login (per PO 30/04/2026)
'
' Collaborator Aggregate:
'   - Each collaborator references exactly one User
'   - One User can be the identity of at most one Collaborator at a time
'   - Position must not be blank
'   - Position and customer reference are immutable post-creation
'   - CollaboratorStatus defaults to ACTIVE on creation
'   - Disabled collaborators must not appear in collaborator listings
'   - CompanyCollaborator: belongs to exactly one AirTransportCompany;
'     identity User must have AisafeRoles = AIR_TRANSPORT_COMPANY_COLLABORATOR
'   - AreaCollaborator: belongs to exactly one AirControlArea;
'     identity User must have AisafeRoles = FLIGHT_CONTROL_OPERATOR
'
' Pilot Aggregate:
'   - Each pilot belongs to exactly one AirTransportCompany
'   - Each pilot references exactly one User (AisafeRoles = PILOT)
'   - A pilot must be certified for one or more AircraftModels
'   - A pilot with assigned FlightPlans cannot be made inactive
'
' Aircraft Aggregate:
'   - Registration must be unique
'   - Must reference exactly one Country (country of registration)
'   - Each aircraft belongs to exactly one AirTransportCompany
'   - Each aircraft is of exactly one AircraftModel
'   - Selected EngineModel must be certified for the AircraftModel
'   - Total seats in CabinConfiguration cannot exceed AircraftModel capacity
'   - Retired aircraft cannot be used to create new flights
'   - An aircraft can only be decommissioned (ACTIVE -> RETIRED) if it has
'     no pending flights, where "pending" means flights with a VALIDATED
'     flight plan (DRAFT and TESTED do not count)
'
' Country Aggregate:
'   - CountryCode must be unique (stable identifier per project spec)
'   - name must be unique at any given time
'   - name is mutable; CountryCode is immutable
'   - Country data is bootstrapped at system startup
'
' AirTransportCompany Aggregate:
'   - companyName must be unique system-wide
'   - CompanyIATACode (2 letters) must be unique
'   - CompanyICAOCode (2-3 letters) must be unique
'
' AirControlArea Aggregate:
'   - AreaCode must be unique across the system
'   - AreaName must be unique across the system
'   - GeographicBoundary must define a non-zero rectangle (SW strictly less than NE on both axes)
'   - GeographicBoundary must not overlap with any existing area
'   - Coordinates VO enforces lat [-90, 90] and lon [-180, 180] at construction
'   - In the MVP the Air Control Area plays the role of the customer entity
'   - A Flight Control Operator (AreaCollaborator) works in exactly one area at a time
'
' Airport Aggregate:
'   - AirportIATACode must be unique worldwide (3 letters)
'   - AirportICAOCode must be unique worldwide (4 letters)
'   - AirportName and Town must not be blank (Town is free text)
'   - Elevation is expressed in metres above sea level (negative values allowed)
'   - AirportCoordinates must be valid
'   - AirportCoordinates must fall within the boundaries of the associated AirControlArea
'   - Must belong to exactly one Country (bootstrapped reference)
'   - Must belong to exactly one AirControlArea
'
' FlightRoute Aggregate:
'   - RouteName must be unique (format: 2 letters + up to 4 numbers)
'   - Route connects exactly two airports (origin != destination)
'
' Flight Aggregate:
'   - FlightDesignator must be unique (format: xxn(n)(n)(n)(a))
'   - Flight type is determined by Departure subclass (RegularDeparture vs CharterDeparture)
'   - CharterDeparture: single departureDate + departureTime
'   - RegularDeparture: 1..* WeekdaySchedule, each with 1..* DepartureTime
'   - Aircraft must not be retired
'   - Pilot must belong to the same company as the route
'   - Flight must reference exactly one route, one aircraft, one pilot
'   - Flight belongs to the route's air transport company
'   - At most one VALIDATED FlightPlan per Flight at any time
'   - FlightPlanStatus transitions: DRAFT (US080 creation) -> VALIDATED
'     (DSL validation in US085 or file import in US081) -> TESTED (simulation test in US085)
'   - Leg n arrival airport == Leg n+1 departure airport
'   - Leg n arrival time < Leg n+1 departure time
'   - FuelLoad must be strictly positive per leg
'   - Each leg must have at least one segment
'   - Segment start and end waypoints must differ
'   - Altitude values must be positive
'   - WindDirection must be 0-360
'   - WindSpeed must be >= 0
'
' WeatherData Aggregate:
'   - Each record references exactly one AirControlArea, which must already
'     exist; the target area is selected once per import and every record in
'     the source is attributed to it (US042 I1, PO 25/05/2026)
'   - A record is zone-banded: WeatherZone is a sub-area bounding box (2
'     Coordinates, SW/NE, reusing the AirControlArea Coordinates VO) carrying
'     one AltitudeBand expressed in feet (US042 sample)
'   - AltitudeBand.lowerFeet < upperFeet, both >= 0 (US042 I4)
'   - TimePeriod.startTime must precede (or equal) TimePeriod.endTime;
'     granularity is defined by the user at registration time (US042 I5)
'   - A valid record needs at least wind; temperature, atmosphericPressure and
'     visibility are optional (absent-tolerant). When present they must be
'     within valid ranges (US042 I7 — relaxes the former US041 pressure>0 rule)
'   - WeatherWindDirection must be 0-360 degrees (US042 I2)
'   - WeatherWindSpeed must be >= 0 (US042 I3)
'   - DataSource (provider/provenance) must not be blank; it is what tells
'     overlapping forecasts apart (US042 I6)
'   - NO uniqueness across (area, zone, band, period): multiple providers
'     (DataSource) may forecast the same area+zone+band+time and all coexist;
'     consumers choose among them downstream (US042 I8, deliberate
'     non-invariant, PO 21/05/2026, CW vs HP samples)
'   - On bulk import an invalid record is reported and skipped; the batch
'     continues and valid rows still persist (US042 I9, controller-level)
'
' SimulationRun Aggregate:
'   - Must reference at least one Flight
'   - TimeRange start must precede end
'   - safetyThreshold must be positive
'   - SimulationStatus transitions: CREATED -> RUNNING -> COMPLETED | FAILED
'   - SimulationResult only present when status is COMPLETED
'   - FlightExecutionStatus: one per included flight; outcome in
'     {COMPLETED, ABORTED, TERMINATED_BY_VIOLATION, CRASHED} (US111)
'   - A SafetyViolation has a ViolationKind: a SEPARATION involves two
'     distinct flights, an altitude ceiling/floor bust involves one (US111)
'   - Each InvolvedFlight carries that aircraft's position and velocity at
'     the moment of the violation
'   - Early termination is supported when safety violations exceed safetyThreshold

@enduml
