    <class>eapli.aisafe.reporting.domain.SimulationRun</class>
    <class>eapli.aisafe.reporting.domain.SimulationRunId</class>
    <class>eapli.aisafe.reporting.domain.FlightExecutionStatus</class>
    <class>eapli.aisafe.reporting.domain.SafetyViolation</class>

    <properties>
      <!-- Local H2 database file in your home folder (~/aisafe-demo.mv.db). AUTO_SERVER lets the consoles and the web app share it.
           The project originally pointed at a shared H2 server on ISEP/DEI infrastructure. -->
      <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:~/aisafe-demo;AUTO_SERVER=TRUE"/>
      <property name="jakarta.persistence.jdbc.user" value="sa"/>
      <property name="jakarta.persistence.jdbc.password" value=""/>
      <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
      <!-- <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/> -->
      <property name="hibernate.hbm2ddl.auto" value="update"/>
      <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
    </properties>
  </persistence-unit>
</persistence>
