<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://maven.apache.org/POM/4.0.0"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>eapli</groupId>
		<artifactId>aisafe</artifactId>
		<relativePath>../</relativePath>
		<version>1.0.0-SNAPSHOT</version>
	</parent>
	<artifactId>aisafe.app.logserver</artifactId>
	<packaging>jar</packaging>
	<name>aisafe.app.logserver</name>
	<description>
		Remote Accesses Logging Server (US090 UDP receiver + US091 HTTP/AJAX status pages).
		Standalone, no AISafe domain or database dependency — deployable to its own cloud node.
	</description>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<mainClass>eapli.aisafe.app.logserver.LogServerApp</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
